+  return JSON.parse(JSON.stringify({result: window._almLastGosh(),
+    count: nodes['m-n'].textContent, median: nodes['m-est'].textContent,
+    i2: nodes['m-i2'].textContent, svg: nodes.plot.innerHTML,
